node_modules
.DS_Store
*.log*
.data
.nuxt
.nitro
.cache
.output
.env
.cargo
dist
# TypeScript incremental build cache (regenerated locally on each typecheck).
*.tsbuildinfo
src-tauri/target
src-tauri/.tools
# Auto-generated by Tauri's build script every time the Rust crate
# compiles. They're IDE-tooling artifacts (JSON schemas for capability
# manifest validation), never consumed at runtime, and produce 13k-line
# diffs on every PR if tracked.
src-tauri/gen/schemas/*.json
# Keep the binaries dir tracked but ignore the actual ~50 MB exe;
# rebuild via `cargo install --locked typst-cli --root src-tauri/.tools`
# then copy bin/typst.exe → binaries/typst-<target-triple>.exe
src-tauri/binaries/*.exe

# JetBrains IDE config (per-developer state, device caches, etc.)
.idea

# Local Claude Code overrides (personal permission allowlist)
.claude/settings.local.json

# License signing private key — must never be committed.
*.signing.key
license-signing.key
*.lic