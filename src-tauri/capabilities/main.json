{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "main",
	"description": "Capabilities for the Sakoram app window",
	"windows": [
		"main",
		"help-*"
	],
	"permissions": [
		"core:path:default",
		"core:event:default",
		"core:window:default",
		"core:window:allow-set-title",
		"core:window:allow-start-dragging",
		"core:window:allow-minimize",
		"core:window:allow-toggle-maximize",
		"core:window:allow-is-maximized",
		"core:window:allow-close",
		"core:window:allow-destroy",
		"core:window:allow-show",
		"core:window:allow-unminimize",
		"core:window:allow-set-focus",
		"core:webview:default",
		"core:webview:allow-create-webview-window",
		"core:app:default",
		"core:resources:default",
		"core:menu:default",
		"core:tray:default",
		"sql:default",
		"sql:allow-load",
		"sql:allow-execute",
		"sql:allow-select",
		"sql:allow-close",
		"dialog:default",
		"dialog:allow-open",
		"dialog:allow-save",
		"dialog:allow-message",
		"dialog:allow-confirm",
		{
			"identifier": "fs:allow-read-file",
			"allow": [
				{ "path": "$APPDATA/**" },
				{ "path": "$APPLOCALDATA/**" },
				{ "path": "$DOCUMENT/**" },
				{ "path": "$DOWNLOAD/**" },
				{ "path": "$DESKTOP/**" },
				{ "path": "$PICTURE/**" },
				{ "path": "$HOME/**" }
			]
		},
		{
			"identifier": "fs:allow-write-file",
			"allow": [
				{ "path": "$APPDATA/**" },
				{ "path": "$APPLOCALDATA/**" },
				{ "path": "$DOCUMENT/**" },
				{ "path": "$DOWNLOAD/**" },
				{ "path": "$DESKTOP/**" },
				{ "path": "$HOME/**" }
			]
		},
		{
			"identifier": "fs:allow-mkdir",
			"allow": [
				{ "path": "$APPDATA/**" },
				{ "path": "$APPLOCALDATA/**" },
				{ "path": "$HOME/**" }
			]
		},
		{
			"identifier": "fs:allow-exists",
			"allow": [
				{ "path": "$APPDATA/**" },
				{ "path": "$APPLOCALDATA/**" },
				{ "path": "$HOME/**" }
			]
		},
		{
			"identifier": "fs:allow-remove",
			"allow": [
				{ "path": "$APPDATA/**" },
				{ "path": "$APPLOCALDATA/**" },
				{ "path": "$HOME/**" }
			]
		},
		"shell:allow-open",
		{
			"identifier": "shell:allow-execute",
			"allow": [
				{
					"name": "binaries/typst",
					"sidecar": true,
					"args": [
						"compile",
						"--root",
						{ "validator": ".+" },
						"--font-path",
						{ "validator": ".+" },
						{ "validator": ".+\\.typ$" },
						{ "validator": ".+\\.pdf$" }
					]
				}
			]
		},
		"notification:default",
		"os:allow-platform",
		"os:allow-arch",
		"os:allow-family",
		"os:allow-version",
		"os:allow-locale",
		"store:default"
	]
}
