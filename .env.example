TAURI_DEV_HOST="0.0.0.0"
TAURI_APPLE_DEVELOPMENT_TEAM="12345"
APPLE_DEVELOPMENT_TEAM="12345"

# Google Drive backup — OAuth client of type "Desktop app" (Google Cloud →
# APIs & Services → Credentials). Read at COMPILE time by src-tauri/build.rs;
# a real env var of the same name wins (that is how CI injects them). Leave
# blank to build without the feature. Copy ONLY the lines you need into `.env`
# — TAURI_DEV_HOST above changes how the dev server binds.
SAKORAM_GOOGLE_CLIENT_ID=
SAKORAM_GOOGLE_CLIENT_SECRET=
